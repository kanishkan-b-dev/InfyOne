# Application Settings
APP_NAME=Athena Institute AI Assistant
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-here
APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=60

# Redis Cloud
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# Chroma Cloud Settings (V2 Collection)
CHROMA_CLOUD_HOST=
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=
CHROMA_COLLECTION_NAME=AthenaCollegeCollection_v2
CHROMA_DISTANCE_METRIC=cosine

# Embedding Settings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=100

# OpenAI API & Model
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Knowledge Retrieval
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SIMILARITY_THRESHOLD=0.25
KNOWLEDGE_MAX_CONTEXT_LENGTH=4000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log
CONVERSATION_LOG_FILE_PATH=logs/conversation.log
